# Copy this file to .env and fill in your own key.
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# real = live data from Open-Meteo (no API key needed) | mock = the book's fake service
WEATHER_MODE=real

CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=models/gemini-embedding-001

# Doc cau tra loi bang giong Gemini TTS that (tts.py, app.py). Tra phi qua
# GOOGLE_API_KEY o tren, pay-as-you-go tren AI Studio. Bo trong -> dung mac
# dinh ben duoi.
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore

# Postgres luu hoi thoai (tuy chon). Bo trong -> state nam trong RAM,
# mat khi restart. Lay chuoi ket noi mien phi tai https://neon.com
# Dung ban POOLED (co '-pooler' trong host) va giu ?sslmode=require.
DATABASE_URL=

# Chan bot bang Cloudflare Turnstile tren app.py (bot_check.py). Bo trong ca
# hai -> tat tinh nang, app.py chi con rate-limit/ngan sach nhu truoc. Lay
# cap key mien phi (khong can the tin dung) tai
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
