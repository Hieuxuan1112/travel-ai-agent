# Copy this file to .env and fill in your own key.
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# real = live data from Open-Meteo (no API key needed) | mock = the book's fake service
WEATHER_MODE=real

CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=models/gemini-embedding-001

# Postgres luu hoi thoai (tuy chon). Bo trong -> state nam trong RAM,
# mat khi restart. Lay chuoi ket noi mien phi tai https://neon.com
# Dung ban POOLED (co '-pooler' trong host) va giu ?sslmode=require.
DATABASE_URL=
